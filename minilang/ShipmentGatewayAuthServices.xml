<simple-methods xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Simple-Method" xsi:schemaLocation="http://ofbiz.apache.org/Simple-Method http://ofbiz.apache.org/dtds/simple-methods.xsd">

    <simple-method method-name="saveShipmentGatewayLogin" short-description="Record the login of one carrier account">
        <call-simple-method method-name="refuseInvalidLogin" scope="inline"/>

        <entity-one entity-name="ShipmentGatewayAuth" value-field="savedLogin"/>
        <if-not-empty field="parameters.publicKey">
            <call-class-method class-name="co.hotwax.shippinggateway.ShipmentGatewayCredentials" method-name="encryptKey" ret-field="encryptedPublicKey">
                <field field="delegator" type="org.apache.ofbiz.entity.Delegator"/>
                <field field="parameters.publicKey" type="String"/>
                <field field="savedLogin.publicKey" type="String"/>
            </call-class-method>
        </if-not-empty>

        <if-empty field="savedLogin">
            <make-value entity-name="ShipmentGatewayAuth" value-field="newLogin" map="parameters"/>
            <set field="newLogin.publicKey" from-field="encryptedPublicKey" set-if-null="true"/>
            <create-value value-field="newLogin"/>
            <else>
                <set-nonpk-fields value-field="savedLogin" map="parameters" set-if-null="false"/>
                <set field="savedLogin.publicKey" from-field="encryptedPublicKey"/>
                <store-value value-field="savedLogin"/>
            </else>
        </if-empty>

        <set field="clearTokenInput.shipmentGatewayConfigId" from-field="parameters.shipmentGatewayConfigId"/>
        <call-service service-name="clearShipmentGatewayToken" in-map-name="clearTokenInput"/>
    </simple-method>

    <simple-method method-name="getShipmentGatewayConnection" short-description="Return the address and the public login fields of one carrier account">
        <entity-one entity-name="ShipmentGatewayConfig" value-field="shipmentGatewayConfig"/>
        <if-empty field="shipmentGatewayConfig">
            <add-error><fail-message message="Carrier account ${parameters.shipmentGatewayConfigId} is not found."/></add-error>
            <check-errors/>
        </if-empty>
        <entity-one entity-name="ShipmentGatewayAuth" value-field="login"/>
        <if-empty field="login">
            <add-error><fail-message message="Carrier account ${parameters.shipmentGatewayConfigId} has no login."/></add-error>
            <check-errors/>
        </if-empty>

        <set field="baseUrl" from-field="login.baseUrl"/>
        <if-empty field="baseUrl">
            <if-compare field="login.testMode" operator="equals" value="N">
                <set field="baseUrlProperty" value="${shipmentGatewayConfig.shipmentGatewayConfTypeId}.url.live"/>
                <else>
                    <set field="baseUrlProperty" value="${shipmentGatewayConfig.shipmentGatewayConfTypeId}.url.test"/>
                </else>
            </if-compare>
            <property-to-field field="baseUrl" resource="shippinggateway" property="${baseUrlProperty}" no-locale="true"/>
        </if-empty>
        <if-empty field="baseUrl">
            <add-error><fail-message message="Carrier account ${parameters.shipmentGatewayConfigId} has no address: its login has none and SystemProperty ${baseUrlProperty} is empty."/></add-error>
            <check-errors/>
        </if-empty>

        <field-to-result field="shipmentGatewayConfig.shipmentGatewayConfTypeId" result-name="shipmentGatewayConfTypeId"/>
        <field-to-result field="baseUrl"/>
        <field-to-result field="login.testMode" result-name="testMode"/>
        <field-to-result field="login.accountNumber" result-name="accountNumber"/>
        <field-to-result field="login.authTypeEnumId" result-name="authTypeEnumId"/>
        <field-to-result field="login.ownerPartyId" result-name="ownerPartyId"/>
    </simple-method>

    <simple-method method-name="refuseInvalidLogin" short-description="Refuse a login for an unknown account, an unknown login type or a key that is too long">
        <entity-one entity-name="ShipmentGatewayConfig" value-field="shipmentGatewayConfig"/>
        <if-empty field="shipmentGatewayConfig">
            <add-error><fail-message message="Carrier account ${parameters.shipmentGatewayConfigId} is not found."/></add-error>
            <check-errors/>
        </if-empty>

        <if-not-empty field="parameters.authTypeEnumId">
            <entity-one entity-name="Enumeration" value-field="authType" auto-field-map="false">
                <field-map field-name="enumId" from-field="parameters.authTypeEnumId"/>
            </entity-one>
            <if>
                <condition>
                    <or>
                        <if-empty field="authType"/>
                        <if-compare field="authType.enumTypeId" operator="not-equals" value="SHIP_GW_AUTH_TYPE"/>
                    </or>
                </condition>
                <then>
                    <add-error><fail-message message="Login type ${parameters.authTypeEnumId} is not a shipment gateway login type."/></add-error>
                </then>
            </if>
        </if-not-empty>

        <if-regexp field="parameters.password" expr="[\s\S]{151,}">
            <add-error><fail-message message="The password is longer than 150 characters."/></add-error>
        </if-regexp>
        <if-regexp field="parameters.publicKey" expr="[\s\S]{151,}">
            <add-error><fail-message message="The public key is longer than 150 characters."/></add-error>
        </if-regexp>
        <check-errors/>
    </simple-method>
</simple-methods>
